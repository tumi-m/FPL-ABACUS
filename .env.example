# All optional locally — the app degrades gracefully without each one.

# Postgres (Neon or Supabase pooler). Unlocks: sampled cohort EO, price
# persistence, GW archiving. Without it everything falls back to estimates.
# Neon:     postgres://…?sslmode=require
# Supabase: use the transaction-pooler URL (port 6543)
DATABASE_URL=

# Upstash Redis. Without it an in-process MemoryStore is used — single-flight
# still works per instance, but swing/rank/price state resets on cold starts.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# When set, /api/cron/* requires Authorization: Bearer <secret>.
# Set this in production. Vercel Cron sends it automatically.
CRON_SECRET=

FPL_USER_AGENT="GAFFER/1.0 (+https://gaffer.app)"
NEXT_PUBLIC_APP_URL=http://localhost:3000
